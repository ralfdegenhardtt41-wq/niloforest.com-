---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<div class="page-head">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>
