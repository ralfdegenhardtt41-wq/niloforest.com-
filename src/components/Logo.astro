---
interface Props { light?: boolean; size?: number }
const { light = false, size = 40 } = Astro.props;
const ink = light ? '#93aa84' : '#1c3a2a';
const ring = light ? '#b79a54' : '#957327';
---
<svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-hidden="true">
  <circle cx="50" cy="50" r="48" fill="none" stroke={ink} stroke-width="1.4"/>
  <circle cx="50" cy="50" r="41" fill="none" stroke={ring} stroke-width="1"/>
  <path d="M50 74 C50 74 34 66 34 52 C34 42 42 34 50 34 C58 34 66 42 66 52 C66 66 50 74 50 74Z" fill="none" stroke={ink} stroke-width="1.6"/>
  <path d="M50 70 L50 38 M50 46 L42 40 M50 46 L58 40 M50 54 L41 47 M50 54 L59 47 M50 62 L43 56 M50 62 L57 56" stroke={ink} stroke-width="1.4" fill="none" stroke-linecap="round"/>
  <path d="M22 78 Q34 70 46 76 T74 74" fill="none" stroke="#6f8f6f" stroke-width="1.2"/>
</svg>
